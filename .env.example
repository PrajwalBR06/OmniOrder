# ===== Copy this file to ".env" and fill in your real values =====

# ASI:One API key (get it from https://asi1.ai -> API Keys)
ASI_ONE_API_KEY=YOur_asi_one_api_key_here
ASI_ONE_BASE_URL=https://api.asi1.ai/v1
ASI_ONE_MODEL=asi1-mini

# Razorpay keys (TEST mode) -> https://dashboard.razorpay.com -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Agent addresses (printed on first run of each agent; paste them here afterward)
COORDINATOR_ADDRESS=
INGESTION_ADDRESS=
INTENT_ADDRESS=
INVOICE_ADDRESS=
PAYMENT_ADDRESS=

# Public URL where the payment webhook listens (use ngrok during the hackathon)
PAYMENT_WEBHOOK_URL=https://your-ngrok-id.ngrok-free.app/razorpay-webhook
